# Copy this file to .env and fill in the values supplied by your Nexus provider.
# Do not share your API key or commit .env to Git.
NEXUS_API_KEY=
# Use the OpenAI-compatible API base URL shown in your Nexus documentation.
# Example shape only: https://your-provider.example/v1
NEXUS_BASE_URL=
NEXUS_MODEL=gpt-4.1-nano
PORT=5000
